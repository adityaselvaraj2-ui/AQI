{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd webapp && npm ci && npm run build",
  "outputDirectory": "webapp/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://REPLACE-ME-airlens-api.hf.space/api/v1/$1"
    },
    {
      "source": "/api/docs",
      "destination": "https://REPLACE-ME-airlens-api.hf.space/api/docs"
    },
    {
      "source": "/docs",
      "destination": "https://REPLACE-ME-airlens-api.hf.space/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://REPLACE-ME-airlens-api.hf.space/openapi.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
